// Maps to the existing `products` table in the live jewelry ERP database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @map("id")
  barcode     String   @unique @map("barcode")
  styleCode   String?  @map("style_code")
  sku         String?  @map("sku")
  itemName    String?  @map("item_name")
  /// Many ERP screens fill `weight` / `avg_wt` while `gross_wt` stays null — see `pickWeightGramsForApi`.
  grossWt     Decimal? @map("gross_wt")
  weight      Decimal? @map("weight")
  avgWt       Decimal? @map("avg_wt")
  isSold      Boolean  @map("is_sold")
  binLocation String?  @map("bin_location")

  @@map("products")
}
